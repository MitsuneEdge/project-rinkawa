---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/indexSidebar.astro';
import Footer from '../components/Footer.astro';
import DivLine from '../components/DivLine.astro';
import DisplayWarn from '../components/displayWarning.astro';
import '../styles/index/indexCharacterIntroduction.css';
import '../styles/index/indexHeroBanner.css';
import '../styles/index/indexGameMechanics.css';
import '../styles/index/indexOverlayWindow.css';
import '../styles/index/indexGameScreenshot.css';
---

<!doctype html>
<html lang="zh-CN">

    <style>
    </style>

	<head>
		<BaseHead title={"早上好！梨猫猫0v0"} description={"欢迎加入卡联联盟系统"} />
	</head>

	<body>
	    {/* 导航栏 */}
		<Header />
        <DisplayWarn />

		{/* 网页头部的巨大海报和字体 */}

		<div class="hero-banner">
		    <div class="hero-banner-blur">
		        <div class="hero-banner-slides">
		            <div class="hero-banner-slide"></div>
		            <div class="hero-banner-slide"></div>
		            <div class="hero-banner-slide"></div>
		            <div class="hero-banner-slide"></div>
		            <div class="hero-banner-slide"></div>
		        </div>
            </div>
		    <div class="hero-content">
		        <div style="
		            width: max-content;
		            font-size: 30px;
		            text-shadow:
                        -1px -1px 0 black,
                         1px -1px 0 black,
                        -1px  1px 0 black,
                         1px  1px 0 black;
		        ">
		            <h1>有笨蛋！</h1>
		        </div>
                <div style="
                    width: max-content;
                    font-size: 20px;
                    text-shadow:
                        -1px -1px 0 black,
                         1px -1px 0 black,
                        -1px  1px 0 black,
                         1px  1px 0 black;
                ">
                    <p>我不说是谁</p>
                </div>

                {/*某种skill issue引起的抽象按钮操作*/}
                <div class="link-container">
                    <a href="/blog" class="btn"
                        style="
                        font-size: 16px;
                        white-space: nowrap;
                        background-color: rgba(0,0,0,0.3);
                        text-decoration: none;
                        border-radius: 4px; /* 圆角 */
                        box-shadow: 1px 1px 3px rgba(0,0,0,0.3);
                        width: max-content;"
                        onmouseover="this.style.transform='scale(1.15)'"
                        onmouseout="this.style.transform='scale(1)'"
                    >
                        松下姐发电
                    </a>
                    <a href="/story" class="btn"
                        style="
                        font-size: 16px;
                        margin-left: 15px;
                        white-space: nowrap;
                        background-color: rgba(0,0,0,0.3);
                        text-decoration: none;
                        border-radius: 4px;
                        box-shadow: 1px 1px 3px rgba(0,0,0,0.3);
                        width: max-content;"
                        onmouseover="this.style.transform='scale(1.15)'"
                        onmouseout="this.style.transform='scale(1)'"
                    >
                        联盟故事会
                    </a>
                </div>
            </div>
        </div>

        <DivLine color="#00ff00" height="10px" class="DivLine-HeroToMain" spacing="0vh" />

        {/* Project-Rinkawa 首页正文部分 */}

        {/* indexCharacterIntroduction.css */}
        <div style="display: grid; grid-template-areas: 'character-container';">
            <div class="character-container">
                <video class="video-background" autoplay muted loop>
                    <source src="/video/indexCharacterIntro.mp4" type="video/mp4">
                    <!-- 后备内容（如果浏览器不支持视频） -->
                    <p>您的浏览器不支持 HTML5 视频</p>
                </video>
                <div class="character-item">
                    <div class="character-trigger-L" id="window-trigger-L"></div>
                    <div class="character-EmptyBlock"></div>
                    <div class="character-trigger-R" id="window-trigger-R"></div>
                </div>
            </div>

            {/*要套一层拟态窗口的div，让窗口锁定这一层*/}
            <div id="overlay-core">
                {/* indexOverlayWindow.css */}
                <div id="overlay-window-L">
                    <div id="indexImage-L" style="flex: 5;"></div>
                        <div id="overlay-content-ContainL" style="flex: 2; align-items: center; flex-direction: column;">
                            <div id="overlay-content-L" style="align-items: center;"></div>
                            <button id="overlay-content-BtnL"
                                    style="
                                    align-items: center;
                                    font-size: 16px;
                                    cursor: pointer;
                                    background-color: #4CAF50;
                                    color: white;
                                    border: none;
                                    border-radius: 5px;
                                    box-shadow: 1px 1px 3px rgba(0,0,0,0.3);
                            ">切换动画</button>
                        </div>
                    </div>
                <div id="overlay-window-R">
                    <div id="overlay-content-ContainR" style="flex: 2; align-items: center; flex-direction: column;">
                        <div id="overlay-content-R" style="align-items: center;"></div>
                        <button id="overlay-content-BtnR"
                            style="
                                align-items: center;
                                font-size: 16px;
                                cursor: pointer;
                                background-color: #4CAF50;
                                color: white;
                                border: none;
                                border-radius: 5px;
                                box-shadow: 1px 1px 3px rgba(0,0,0,0.3);
                            ">切换动画</button>
                        </div>
                        <div id="indexImage-R" style="flex: 5;"></div>
                    </div>
            </div>
        </div>

        <DivLine color="#00ff00" height="10px" class="DivLine-ScreenShot" spacing="0vh" />
        {/*网页主体*/}

        <main>
            {/* indexGameScreenshot.css */}
            <div class="GameScreenshot-container">
                <div style="background-color: transparent; text-align: center; width: 100%; margin-bottom: 20px;">
                    <p style="font-size: 30px"><b>文章设定集</b></p>
                </div>
                <div class="GameScreenshot-content">
                    <div class="GameScreenshot-L"></div>
                    <div class="GameScreenshot-R"></div>
                </div>
            </div>

            <DivLine color="#00ff00" height="10px" class="DivLine-GameMechanics" />

            {/* indexGameMechanics.css */}
            <div class="GameMechanics-container">
                <div class="GameMechanics-title">
                    <p style="text-align: center; font-size: 30px;"><b>联盟宣传</b><p>
                </div>
                <div class="GameMechanics-image">
                    <div class="GameMechanics-L">
                            <div class="GameMechanics-L-module">模块 1</div>
                            <div class="GameMechanics-L-module">模块 2</div>
                            <div class="GameMechanics-L-module">模块 3</div>
                            <div class="GameMechanics-L-module">模块 4</div>
                            <div class="GameMechanics-L-module">模块 5</div>
                        </div>
                    <div class="GameMechanics-R" id="rightContent"></div>
                </div>
            </div>

            <DivLine color="#00ff00" height="10px" class="DivLine-storyIntroduce" />


            {/* 介绍 */}
            <div class="storyIntroduce" style="background-color: transparent;">
                <p style="text-align: center; font-size: 35px;"><b>关于 卡蒂斯研究集团与C.M.A.F.联邦 联盟</b></p>
                <p style="text-align: center; font-size: 22px;">Since 244.2.5.22 LST</p>
                <p style="text-align: center; font-size: 22px;">
                    横跨数亿光年的超级星际联盟
                </p>
                <p style="text-align: left; text-indent: 2em; font-size: 18px;">
                    穿越三角星门的白色丝带，与系着铃铛的猫。
                    自2099.12.21从地球撤离，经历280年（LST）的发展，C.M.A.F.联邦现已成为星系中最大的政治体。
                    潜藏在卡蒂斯首星的秘密总是那么诱人，但也就是这样的秘密，令卡蒂斯研究集团以超级巨企的姿态活跃于星系舞台上。
                    四大家族控制联邦系统的方方面面，八大企业组成现如今的研究集团。
                    欢迎来到卡蒂斯研究集团与C.M.A.F.联邦联盟，加入联盟远征舰队，探索宇宙边缘的奥秘。
                </p>
                <p style="text-align: left; text-indent: 2em; font-size: 18px;">
                    联邦当前控制区自SM-A01向外辐射，越过超大质量黑洞SM-A02与后花园A03，直到星云边陲的破碎之地SM-A33，半径百万光年；
                    A星域有33个被赋予序号的殖民星系，并夹杂超过1000个简单编号的采矿星系，联邦的立国之本均位于此，并由强大的值守舰队牢牢掌控。
                    若要问已知星系中最富庶的地方位于何处，那必然是A01星系及其周围4星的核心星座；
                    若要问已知星系中最秀丽的星球位于何方，那只能是经过精心环境改造的SM-A03；
                    若要问已知星系中最神秘的空间站位于何地，那或许是SM-A02的联邦黑洞观测中心。
                    联邦空域近800亿人口，超过90%均在A星域定居；最复杂的三角星门网络覆盖了整个A星域——正如联邦国旗，穿越三角的白色丝带。
                    深空探索的核心，进攻的前锋，联邦深空星际舰队，10个舰队分布在A星域的4个舰队基地，并由275km级星门相互连接；
                    同时在各星系安装固定诱导力场信标，使得超级旗舰的舰队超空间联合投送设备与“千叶之光-CDC”星际港的星际弹射台，
                    能够将联邦的利剑迅速刺入妄图染指联邦空域的敌人心脏。
                </p>
                <p style="text-align: left; text-indent: 2em; font-size: 18px;">
                    从A33离开A星域向银河外围前进，则是曾经星际聚合联盟430殖民星域首府，现联邦B星域管制区——SM-B01，原称430堡垒的外星集会点。
                    其包含了无数宇宙间的奇观，既有神秘的三星系统，又有上古文明的奇特遗迹，更是星际舰队的碎裂坟场。
                    B星域在原先的430星域基础上有所扩展，核心区是环绕SM-B01的5个殖民星系，剩下的部分则是残酷的险恶之地，人迹罕至，
                    星域的55个殖民星系中，只有靠近B01的8个星系与他们的采矿星系能够获得联邦值守舰队的保护，安全程度与联邦首星相同。
                    其余47个星系则是按照附近的银河地标划分，诸如脉冲星与红巨星，曾经的舰队战场和歼星舰遗骸，组成大大小小9个星座。
                    土匪强盗罪犯，叛乱分子和当地军阀，是这些星座的实际控制者。超光速抑制器随处可见，各类干扰力场阻止了远程传感器的刺探。
                    拾荒者从舰队坟场打捞获取的较为落后的超光速阻碍设备，加上B星域因使用行星毁灭武器造成的引力异常，此刻成了一道天堑。
                    未经专门调制过的超空间推进器，进入这片是非之地很容易出现故障，甚至能把舰船从深空中抛出，或是直接冲进附近的重力井。
                    因此，联邦只是在名义上拥有这些领土，并未实际控制——就和原主人星际聚合一样。
                </p>
                <p style="text-align: left; text-indent: 2em; font-size: 18px;">
                    SM-A33与SM-B01连线中间，曾经存在一颗明亮的恒星。那是曾经的太阳系，178年的第二次联盟战争中被星际聚合一方，以行星毁灭武器摧毁。
                    在这条连线的所谓“上方”，则是卡蒂斯研究集团。由于研究集团的空域偏离银河系的黄道面过远，即使卡蒂斯的实控区已经很接近A星域的半径，
                    卡蒂斯所拥有的恒星数量不过千颗，殖民星系只有9个，且跨度大的惊人，KRS-01与SM-A33“上方”的KRS-06之间的距离，已是十万光年；
                    且这些恒星通常较小，用于超空间导航的重力井边界信标距离中央恒星最近的只有6AU，卡蒂斯的殖民星球大多是冰封星球，且难以改造。
                    星系之间如此遥远，卡蒂斯的星座在星图上，像是某种形式的高速公路，穿过研究集团的脉冲超空间跳跃桥，一个跳跃等价于联邦空域的数个跳跃。
                    不过受制于卡蒂斯自身历史的特殊性，卡蒂斯母星并不对外交用途舰船以外的舰船开放，且研究集团的跳跃桥为放射布局，
                    必须通过KRS-01星系才能抵达其他星系，因此在联邦与研究集团首次接触，到卡联联盟成立的25年间，这一高速公路并未对外开放。
                    联盟成立后，联邦的高科集团介入，洛高集团协助建设了卡蒂斯空域的星门网络，北航工业则提供了全频段超光速拦截设备以屏护KRS-01，
                    诺顿带来的设备则为冰封殖民星球的宜居改造创造了条件。安雅莉亚航空工业的回报，是超越联邦的星舰材料技术和先进的舰队协调系统，
                    促成了后来联盟的深空探索项目——世界边缘计划，和这一项目的最终幻想——6艘长轴220km的世界边缘级深空探索母舰。
                </p>
                <p style="text-align: left; text-indent: 2em; font-size: 18px;">
                    现在的卡联联盟系统是已知星系中最大的政治体，屹立于数百个国家城邦之首。
                    银河中尚有不少秘密等待探索，卡联联盟愿意做这个先驱。
                </p>
            </div>
        </main>

		<Footer />
		<script src="../script/index/indexOverlayWindow.js"></script>
        <script src="../script/index/indexOverlaySwitch.js"></script>
		<script src="../script/index/indexGameMechanicsImage.js"></script>
        <script src="../script/index/indexGameScreenshot.js"></script>
	</body>
</html>
